# Copy this file to .env and fill in what you need. Almost everything
# has a sensible default, the one setting most installs have to make
# is ORIGIN.

# The address browsers reach jCar at, scheme included. Form posts are
# checked against it, and the session cookie's Secure flag follows
# its scheme, so an http address still lets you sign in over plain
# http while an https address gets Secure cookies.
# Examples: http://192.168.1.50:3000 or https://jcar.example.com
ORIGIN=http://localhost:3000

# Timezone for dates and the "this month" chart ranges.
TZ=UTC

# Where the SQLite database file lives. Inside the container this is
# /app/data/jcar.db and the compose file mounts ./data there, so your
# data survives image updates. Only change it if you run the app
# outside Docker.
DATABASE_PATH=/app/data/jcar.db

# Port and bind address inside the container. The compose file maps
# port 3000 to the host, change the mapping there instead.
PORT=3000
HOST=0.0.0.0

# Largest single photo upload the app accepts, in bytes (default
# 20 MB). Uploads are re-encoded on the server to small JPEGs, this
# only gates the raw camera files people attach.
MAX_PHOTO_BYTES=20971520

# Largest request body the server accepts, in bytes (default 25 MB).
# It has to fit a form carrying several MAX_PHOTO_BYTES photos.
BODY_SIZE_LIMIT=26214400

# --- AI Auto Fill (optional) ---
# AI Auto Fill reads a photo of a fuel receipt or pump and fills in
# the fuel-up form. It talks to any OpenAI compatible chat completions
# endpoint. Leave AI_API_BASE_URL or AI_MODEL unset and the feature
# stays off, the page just shows a not configured notice.
#
# Example, OpenRouter (hosted, many models, needs a key):
#   AI_API_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=your key
#   AI_MODEL=google/gemma-4-31b-it
# That model was a good balance of low cost and accuracy when this
# was tested, a few tenths of a cent per photo.
#
# Example, a local model server (no key needed):
#   AI_API_BASE_URL=http://host.docker.internal:11434/v1
#   AI_MODEL=whatever model you have loaded
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Some endpoints accept a reasoning effort hint. It is not part of
# the OpenAI spec, so it is only sent when you set it here. Hosted
# endpoints that accept it usually want low, medium or high.
AI_REASONING_EFFORT=

# --- Plans (leave unset for a normal install) ---
# jCar runs unlimited by default, no vehicle limits, no record
# retention, every feature open. Setting this to 1 turns on the plan
# system (Free and Paid accounts with limits, set at signup and
# managed in Admin). It exists for the hosted service, most installs
# will never want it.
PLANS_ENABLED=

# --- Notifications ---
# A full ntfy topic URL. New registrations and feedback submissions
# post a notification there. Unset means no notifications are sent.
NTFY_URL=

# When set, the sign-in page shows an "or try the live demo" link
# pointing at this address. Unset means no link.
DEMO_URL=

# Demo mode. A demo deployment sets this to 1 and every visitor is
# signed in as a shared demo account with no login. Never set this
# on a real install.
DEMO_MODE=

# --- Analytics (optional) ---
# Umami is the only analytics supported, it is self hosted and the
# two values are public (they ship in every page). Both must be set
# for the script to load.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# --- Sign-in and signup protection tunables ---
# Failed sign-ins: this many in a row locks that account and IP pair
# for the lock window, and this many failures from one IP locks the
# whole IP. Signups are capped per IP per window with a global
# circuit breaker on top.
LOGIN_LOCK_MAX=10
LOGIN_IP_LOCK_MAX=50
LOGIN_LOCK_MS=900000
REG_PER_IP_MAX=10
REG_GLOBAL_MAX=100
REG_WINDOW_MS=3600000
